{
  "name": "set_alarm",
  "description": "Set an alarm on this phone.",
  "arguments": [
    {
      "name": "time",
      "type": "string",
      "required": true,
      "description": "Local phone time in 24-hour HH:MM format.",
      "format": "HH:MM"
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "description": "Optional alarm label."
    },
    {
      "name": "days",
      "type": "string_array",
      "required": false,
      "description": "Optional repeat weekdays.",
      "values": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
    }
  ]
}
