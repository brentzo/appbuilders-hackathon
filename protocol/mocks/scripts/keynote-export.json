{
  "description": "A goal from the Mac: repeat-back, planning, the main cursor exporting the Keynote deck, and the spoken summary.",
  "trigger": "submitGoal",
  "events": [
    { "afterMs": 300, "event": "goalRestated", "payload": { "taskId": "6f1d2c3b-4a5e-4f60-8172-93a4b5c6d7e8", "text": "You want me to export your Keynote deck as a PDF. Should I go ahead?" } },
    { "afterMs": 300, "event": "cursorCommand", "payload": { "command": "spawn", "cursorId": "main", "cursorKind": "main" } },
    { "afterMs": 1500, "event": "taskStatusChanged", "payload": { "taskId": "6f1d2c3b-4a5e-4f60-8172-93a4b5c6d7e8", "status": "planning" } },
    { "afterMs": 1500, "event": "taskStatusChanged", "payload": { "taskId": "6f1d2c3b-4a5e-4f60-8172-93a4b5c6d7e8", "status": "running" } },
    { "afterMs": 100, "event": "routeDecided", "example": "RouteDecided.main" },
    { "afterMs": 100, "event": "cursorCommand", "example": "CursorCommand.set-state" },
    {
      "afterMs": 1200,
      "event": "cursorCommand",
      "payload": {
        "command": "move",
        "cursorId": "main",
        "to": {
          "kind": "element",
          "target": { "bundleId": "com.apple.Keynote", "windowId": 4182 },
          "elementPath": "AXApplication/AXMenuBar/AXMenuBarItem[File]/AXMenu/AXMenuItem[Export To]"
        }
      }
    },
    { "afterMs": 400, "event": "cursorCommand", "payload": { "command": "setState", "cursorId": "main", "state": "acting" } },
    { "afterMs": 1500, "event": "taskStatusChanged", "example": "TaskStatusChanged.subtask-done" },
    { "afterMs": 300, "event": "taskStatusChanged", "payload": { "taskId": "6f1d2c3b-4a5e-4f60-8172-93a4b5c6d7e8", "status": "done" } },
    { "afterMs": 100, "event": "speak", "example": "Speak.summary" },
    { "afterMs": 500, "event": "cursorCommand", "payload": { "command": "fade", "cursorId": "main" } }
  ]
}
