{
  "name": "@yumi/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Yumi shared contracts: JSON Schemas, validation, and generated TypeScript, Swift, and Kotlin types.",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./generated/ts/index.ts",
    "./crypto": "./src/crypto.ts",
    "./messages": "./src/messages.ts"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "check:generated": "tsx scripts/generate.ts --check",
    "vectors": "tsx scripts/vectors.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "compile:swift": "tsx scripts/compile-check.ts swift",
    "compile:kotlin": "tsx scripts/compile-check.ts kotlin",
    "mock:harness": "tsx mocks/mock-harness.ts",
    "mock:mac": "tsx mocks/mock-mac-app.ts",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "libsodium-wrappers": "0.8.4"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "0.8.2",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
