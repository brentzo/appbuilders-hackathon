<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only. Compose draws everything else with YumiTheme. -->
    <style name="Theme.Yumi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/yumi_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/yumi_paper</item>
    </style>
</resources>
