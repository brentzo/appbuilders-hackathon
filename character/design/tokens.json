    "scale": [
      {"name": "display", "family": "display", "size": 40, "lineHeight": 44, "weight": 800, "usage": "Hero lines and the wordmark."},
      {"name": "title", "family": "display", "size": 24, "lineHeight": 28, "weight": 700, "usage": "Screen and card titles."},
      {"name": "headline", "family": "display", "size": 19, "lineHeight": 24, "weight": 650, "usage": "Section headings, Yumi's spoken line on screen."},
      {"name": "body", "family": "text", "size": 15, "lineHeight": 21, "weight": 400, "usage": "Body copy."},
      {"name": "label", "family": "text", "size": 13, "lineHeight": 18, "weight": 600, "usage": "Buttons and chips."},
