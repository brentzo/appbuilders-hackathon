    ],
    "macNote": "Mac panels use the system font at the same sizes so they feel native; the display family is for Android and marketing."
  },
  "space": {"xxs": 2, "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24, "xxl": 32, "xxxl": 48},
  "radius": {
    "control": 7,
    "field": 10,
    "panel": 16,
    "card": 24,
    "pill": 999
  },
  "motion": {
    "moveMinMs": 350,
    "moveMaxMs": 700,
    "moveFarPt": 1200,
    "pounceMs": 300,
    "fadeOutMs": 1000,
    "panelMs": 350,
    "easing": [0.65, 0, 0.35, 1],
    "avoidRadiusPt": 24,
    "avoidFadeOpacity": 0.25,
    "avoidFadeMs": 150,
    "avoidReturnMs": 1000,
    "note": "SPEC-04 r2 and r17: moves ease in and out on a symmetric curve, 350 ms for a short hop up to 700 ms at moveFarPt or farther, with an arc, and never teleport; cursors fade out within 1 second; Reduce Motion turns leaps, pounces, and arcs into straight glides. SPEC-04 r21: when the pointer moves toward a cat and comes within avoidRadiusPt of its body (not its center), the cat fades in place to avoidFadeOpacity over avoidFadeMs and never moves away; an idle, thinking, or paused cat also lays its ears back; a cat that appears next to a still pointer stays put; avoidReturnMs after the pointer leaves, it fades back."
  }
}
